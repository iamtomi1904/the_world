# Copy to .env. Do not commit .env or share its contents.
# PostgreSQL local: use your own role/password; Neon: paste dashboard connection string.
# DATABASE_URL=postgresql://an_thanh:YOUR_PASSWORD@127.0.0.1:5432/an_thanh
# For online HTTPS set the exact public origin, with no trailing path.
# PUBLIC_ORIGIN=https://your-game.example
PORT=3000
# Development without DATABASE_URL uses the existing local SQLite database.
# Production requires PostgreSQL:
# NODE_ENV=production

# MMORPG requires DATABASE_URL even in development. Optional local-only map tools:
# MMO_DEV_MAP_TOOLS=1
